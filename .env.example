# ---------- General ----------
PORT=3000
HEADLESS=true
# Be nice: delay between page interactions (ms)
SCRAPE_MIN_DELAY_MS=1200
# Set to 1 to dump raw HTML of every visited page into ./debug (selector calibration)
DEBUG_SCRAPER=0
# Default scraping schedule, in minutes (0 = no automatic run)
SCRAPE_INTERVAL_MINUTES=360
DATA_DIR=./data
SESSIONS_DIR=./sessions

# ---------- Maximilien (https://marches.maximilien.fr) ----------
MAXIMILIEN_ENABLED=true
MAXIMILIEN_USERNAME=
MAXIMILIEN_PASSWORD=
# Optional: direct URL of the advanced search results page once you are logged in
MAXIMILIEN_SEARCH_URL=

# ---------- AW Solutions (https://www.marches-publics.info) ----------
AWSOLUTIONS_ENABLED=true
AWSOLUTIONS_USERNAME=
AWSOLUTIONS_PASSWORD=
AWSOLUTIONS_SEARCH_URL=

# ---------- achatpublic.com (https://www.achatpublic.com/sdm) ----------
ACHATPUBLIC_ENABLED=true
ACHATPUBLIC_USERNAME=
ACHATPUBLIC_PASSWORD=
ACHATPUBLIC_SEARCH_URL=

# ---------- e-marchespublics.com ----------
EMARCHESPUBLICS_ENABLED=true
# Only needed if you extend the scraper to the logged-in search area
EMARCHESPUBLICS_USERNAME=
EMARCHESPUBLICS_PASSWORD=

# ---------- Bpifrance (https://www.bpifrance.fr/appels-offres) - public, no login ----------
BPIFRANCE_ENABLED=true

# ---------- Partenaire GC (https://partenaire-gc.com/espace-abonne) - paid subscriber area ----------
# No username/password here: the login form has an anti-bot check, so you log in yourself once with
# `npm run login:session -- partenaire-gc` (saves SESSIONS_DIR/partenaire-gc.json) and rerun it when
# the session expires.
PARTENAIREGC_ENABLED=true
# Optional: another page showing the "Consultations en cours" listing, e.g. the site's own search
# https://partenaire-gc.com/consultations?field_affaire_enseigne_value=... (default: the subscriber area home)
PARTENAIREGC_SEARCH_URL=

# ---------- Claude analysis of offer details (Partenaire GC) ----------
# Anthropic API key (console.anthropic.com > API keys). Server-side only, never commit it.
# Empty: offers are still scraped, but not analysed (each run reports it).
ANTHROPIC_API_KEY=
# Maximum number of Claude calls per run (new offers that passed the free IT keyword filter, see
# src/analysis/it-keywords.ts); the others wait for the next run. 0: keyword filter only, no Claude call.
ANALYSIS_MAX_PER_RUN=40

# ---------- Sending relevant offers to MyBestConsultant's AO inbox (`npm run ao:send`) ----------
# Same variables and values as the veille (veille-marches-emplois/.env): the mailbox that sends the offers.
SMTP_HOST=smtp.example.fr
# 587 (STARTTLS, default) or 465 (TLS). An encrypted connection is always required.
SMTP_PORT=587
SMTP_USER=veille@example.fr
SMTP_PASSWORD=
# Sender: the SMTP_USER mailbox (or one of its aliases), on the same domain as OFFERS_TO — otherwise
# MyBestConsultant takes the sender for the client of the offer (its ADR 0004).
MAIL_FROM="Veille Partenaire GC <veille@example.fr>"
# MyBestConsultant's AO inbox: each offer is sent in its own email.
OFFERS_TO=ao@example.fr
